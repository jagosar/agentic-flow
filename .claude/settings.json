{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/bin/agentic.py:*)",
      "Workflow(agentic-implement)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/bin/agentic.py\" hook"
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "1800000",
    "BASH_MAX_TIMEOUT_MS": "1800000"
  }
}
